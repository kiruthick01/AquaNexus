# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment
.env

# Notebooks
.ipynb_checkpoints/

# Data — large binaries and derived artefacts stay out of git.
# LAS tiles from the Saitama release average ~520 MB each.
data/raw/*
data/processed/*
data/hecras/*
data/models/*
data/cache/*
!data/**/.gitkeep
# The held-out river result is the exception: 5 KB of numbers, and regenerating
# it needs HEC-RAS on Windows and 28 GB of LAS tiles that are not in the repo.
# Tracking it is what lets a plain clone serve GET /holdout.
!data/processed/holdout_naka.json
*.las
*.laz
*.tif
*.zip

# HEC-RAS run artefacts
*.O0*
*.r0*
*.p0*.hdf
*.dss

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
.env.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
