# Copy to .env.local and adjust. Vite only exposes variables prefixed VITE_.
#
# Local development only. In a container the address comes from $API_BASE_URL,
# which the entrypoint writes into /config.js at start-up - so a built image can
# be repointed without rebuilding. This variable wins when set, because it is
# the more convenient knob when running a dev server.
VITE_API_BASE_URL=http://localhost:8000
