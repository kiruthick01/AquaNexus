# Copy to .env and adjust. Never commit .env.

# Path to the HEC-RAS executable (Windows). Adjust for your installed version.
HECRAS_EXE=C:\Program Files (x86)\HEC\HEC-RAS\6.5\Ras.exe
HECRAS_TIMEOUT=600

# Study site — see docs/DATA_SOURCES.md
RIVER_NAME=Ayase
CRS_EPSG=6677

# ML
MODEL_TYPE=xgboost
RANDOM_SEED=42

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Logging
LOG_LEVEL=INFO
